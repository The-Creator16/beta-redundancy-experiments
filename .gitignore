# ---------------------------------------------------------------------------
# Scratch output directories (smoke tests, ad-hoc runs)
# The canonical committed results live in results/experiment_01 ... 07.
# Anything with a suffix (e.g. *_smoke) is transient and not tracked.
# ---------------------------------------------------------------------------
results/*_smoke/
results/**/scratch/
/tmp_results/

# Generated outputs
results/all/
results/journal/
results/supplementary/
results/smoke/
results/.build-*/
